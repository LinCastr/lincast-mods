import { LineEdit, ScrollView } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #121418;
    out property <color> sidebar: #0d0f12;
    out property <color> surface: #181b20;
    out property <color> hover: #1e2228;
    out property <color> line: #24282f;
    out property <color> text: #e4e6ea;
    out property <color> dim: #8a919b;
    out property <color> faint: #5c636d;
    out property <color> accent: #4d8eff;
    out property <color> warn: #e0b04a;
    out property <color> error: #e5534b;
    out property <length> radius: 6px;
}

export struct GameItem {
    appid: int,
    name: string,
    loader: string,
}

export struct ModItem {
    id: string,
    name: string,
    detail: string,
    enabled: bool,
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 34px;
    height: 18px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : #333840;
    animate background { duration: 120ms; }
    Rectangle {
        width: parent.height - 6px;
        height: self.width;
        y: 3px;
        x: on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: white;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    callback clicked;
    height: 32px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.12) : Theme.accent)
                        : (ta.has-hover ? #ffffff1f : #ffffff14);
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if icon.width > 0: Image {
            source: icon;
            width: 14px;
            colorize: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component GameRow inherits Rectangle {
    in property <GameItem> game;
    in property <bool> selected;
    callback clicked;
    height: 44px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff08 : transparent);
    Rectangle {
        x: 0;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: selected ? Theme.accent : transparent;
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 8px;
        alignment: center;
        spacing: 1px;
        Text {
            text: game.name;
            color: selected ? Theme.text : #c9cdd3;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: game.loader;
            color: Theme.faint;
            font-size: 11px;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModRow inherits Rectangle {
    in property <ModItem> item;
    callback toggled(bool);
    callback remove();
    // Primeiro clique em "Remover" pede confirmação; some sozinho em 3 s.
    property <bool> confirm;
    height: 52px;
    background: ta.has-hover || rm.has-hover ? #ffffff06 : transparent;
    ta := TouchArea { }
    Timer {
        interval: 3s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: item.name;
                color: item.enabled ? Theme.text : Theme.faint;
                font-size: 13px;
                overflow: elide;
            }
            if item.detail != "": Text {
                text: item.detail;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        Rectangle {
            width: rm-text.preferred-width + 16px;
            opacity: ta.has-hover || rm.has-hover || root.confirm ? 1 : 0;
            animate opacity { duration: 100ms; }
            rm-text := Text {
                text: root.confirm ? "Confirmar remoção" : "Remover";
                color: root.confirm ? Theme.error : (rm.has-hover ? Theme.text : Theme.faint);
                font-size: 12px;
                vertical-alignment: center;
            }
            rm := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.confirm {
                        root.confirm = false;
                        root.remove();
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
        Toggle {
            y: (parent.height - self.height) / 2;
            on: item.enabled;
            toggled(v) => { root.toggled(v); }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        x: 20px;
        width: parent.width - 40px;
        background: Theme.line;
    }
}

component SideLink inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff08 : transparent);
    Text {
        x: 14px;
        text: root.text;
        color: selected ? Theme.text : Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component GroupLabel inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

component LinkText inherits Text {
    callback clicked;
    color: lta.has-hover ? Theme.text : Theme.dim;
    font-size: 12px;
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    padding: 32px;
    spacing: 8px;
    alignment: start;

    Text {
        text: "Configurações";
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
    }
    Rectangle { height: 16px; }

    GroupLabel { text: "NEXUS MODS"; }
    Text {
        text: "Chave da API";
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        key := LineEdit {
            width: 420px;
            input-type: password;
            placeholder-text: root.nexus-ok ? "Chave salva. Cole outra para trocar." : "Cole a chave aqui";
            accepted(t) => {
                if t != "" && !root.key-busy {
                    root.save-key(t);
                    self.text = "";
                }
            }
        }
        Button {
            text: root.key-busy ? "Verificando…" : "Salvar";
            primary: true;
            clicked => {
                if key.text != "" && !root.key-busy {
                    root.save-key(key.text);
                    key.text = "";
                }
            }
        }
        if root.nexus-ok: Button {
            text: "Apagar chave";
            clicked => { root.clear-key(); }
        }
    }
    Text {
        text: root.nexus-status;
        color: root.nexus-ok ? Theme.dim : Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.nexus-ok: LinkText {
        text: "Gerar a chave em nexusmods.com (Configurações → API Keys, no fim da página)";
        clicked => { root.open-key-page(); }
    }

    Rectangle { height: 20px; }
    Rectangle { height: 1px; background: Theme.line; }
    Rectangle { height: 12px; }

    GroupLabel { text: "LINKS DO SITE"; }
    Text {
        text: "Abrir no linex-mods o botão \"Mod Manager Download\" do Nexus";
        color: Theme.text;
    }
    if root.handler-ok: Text {
        text: "Ativo.";
        color: Theme.dim;
        font-size: 12px;
    }
    if !root.handler-ok: HorizontalLayout {
        alignment: start;
        Button {
            text: "Ativar";
            clicked => { root.register-handler(); }
        }
    }
    Text {
        text: "Na primeira vez, o navegador pergunta qual programa abre o link: escolha o linex-mods.";
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "linex-mods";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 13px;

    in property <[GameItem]> games;
    in property <[ModItem]> mods;
    in-out property <int> current: -1;
    in property <string> game-name;
    in property <string> game-status;
    in property <bool> game-warning;
    in property <string> counts;
    in property <image> hero;
    in property <image> logo;
    in property <string> message;
    in property <bool> message-error;
    in property <bool> busy;
    in-out property <string> filter;
    in-out property <int> page;
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;

    callback select-game(int);
    callback toggle-mod(string, bool);
    callback remove-mod(string);
    callback add-mod();
    callback play();
    callback open-folder();
    callback filter-changed(string);
    callback show-settings();
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    callback nxm-received(string);
    callback nxm-finished(int, string, bool);

    HorizontalLayout {
        // Barra lateral: jogos.
        Rectangle {
            width: 240px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px;
                padding-top: 18px;
                spacing: 2px;
                Text {
                    text: "linex-mods";
                    color: Theme.dim;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }
                Rectangle { height: 14px; }
                Text {
                    text: "JOGOS";
                    color: Theme.faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }
                Rectangle { height: 6px; }
                for g[i] in root.games: GameRow {
                    game: g;
                    selected: i == root.current && root.page == 0;
                    clicked => {
                        root.page = 0;
                        root.current = i;
                        root.select-game(i);
                    }
                }
                if root.games.length == 0: Text {
                    text: "Nenhum jogo com loader de mods encontrado.";
                    color: Theme.faint;
                    wrap: word-wrap;
                }
                Rectangle { }
                SideLink {
                    text: "Configurações";
                    selected: root.page == 1;
                    clicked => {
                        root.page = 1;
                        root.show-settings();
                    }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            SettingsPage {
                nexus-status: root.nexus-status;
                nexus-ok: root.nexus-ok;
                key-busy: root.key-busy;
                handler-ok: root.handler-ok;
                save-key(k) => { root.save-key(k); }
                clear-key => { root.clear-key(); }
                register-handler => { root.register-handler(); }
                open-key-page => { root.open-key-page(); }
            }
            Rectangle { }
            if root.message != "": Rectangle {
                height: 34px;
                background: Theme.sidebar;
                Text {
                    x: 20px;
                    text: root.message;
                    color: root.message-error ? Theme.error : Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    width: parent.width - 40px;
                }
            }
        }

        // Conteúdo.
        if root.page == 0: VerticalLayout {
            // Cabeçalho com a arte do jogo desfocada.
            Rectangle {
                height: 168px;
                clip: true;
                background: Theme.surface;
                Image {
                    source: root.hero;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: 0.55;
                }
                Rectangle {
                    background: @linear-gradient(180deg, #12141800 0%, #121418 100%);
                }
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 18px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: end;
                        spacing: 4px;
                        if root.logo.width > 0: Image {
                            source: root.logo;
                            height: 64px;
                            image-fit: contain;
                            horizontal-alignment: left;
                        }
                        if root.logo.width == 0: Text {
                            text: root.game-name;
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.game-status;
                            color: root.game-warning ? Theme.warn : Theme.dim;
                            font-size: 12px;
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Abrir pasta";
                                clicked => { root.open-folder(); }
                            }
                            Button {
                                text: root.busy ? "Instalando…" : "Adicionar mod";
                                icon: @image-url("icons/plus.svg");
                                clicked => { if !root.busy { root.add-mod(); } }
                            }
                            Button {
                                text: "Jogar";
                                icon: @image-url("icons/play.svg");
                                primary: true;
                                clicked => { root.play(); }
                            }
                        }
                    }
                }
            }

            // Busca e contagem.
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 12px;
                LineEdit {
                    placeholder-text: "Buscar mod";
                    text <=> root.filter;
                    edited(t) => { root.filter-changed(t); }
                }
                Text {
                    text: root.counts;
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                VerticalLayout {
                    for m in root.mods: ModRow {
                        item: m;
                        toggled(v) => { root.toggle-mod(m.id, v); }
                        remove => { root.remove-mod(m.id); }
                    }
                    if root.mods.length == 0 && root.current >= 0: Text {
                        text: root.filter == "" ? "Nenhum mod instalado. Use \"Adicionar mod\" para instalar um arquivo .zip." : "Nenhum mod com esse nome.";
                        color: Theme.faint;
                        horizontal-alignment: center;
                        height: 80px;
                        vertical-alignment: center;
                    }
                }
            }

            // Linha de mensagem (resultado da última ação).
            if root.message != "": Rectangle {
                height: 34px;
                background: Theme.sidebar;
                Text {
                    x: 20px;
                    text: root.message;
                    color: root.message-error ? Theme.error : Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    width: parent.width - 40px;
                }
            }
        }
    }
}
