import { ScrollView } from "std-widgets.slint";

// Interface colors. Rust swaps them all at once (default theme or wallust).
export global Theme {
    in-out property <color> bg: #121418;
    in-out property <color> sidebar: #0d0f12;
    in-out property <color> surface: #181b20;
    in-out property <color> raised: #1d2026;
    in-out property <color> hover: #1e2228;
    in-out property <color> line: #24282f;
    in-out property <color> text: #e4e6ea;
    in-out property <color> dim: #8a919b;
    in-out property <color> faint: #5c636d;
    in-out property <color> accent: #4d8eff;
    in-out property <color> on-accent: #ffffff;
    in-out property <color> warn: #e0b04a;
    in-out property <color> error: #e5534b;
    // Brand marks of the two mod sites (their own colors, not the theme's).
    out property <color> nexus: #da8e35;
    out property <color> thunderstore: #23ffb0;
    out property <length> radius: 6px;
}

export struct GameItem {
    appid: int,
    name: string,
    loader: string,
    icon: image,
}

export struct UnityItem {
    appid: int,
    name: string,
    kind: string,
    icon: image,
}

export struct Notice {
    id: int,
    text: string,
    error: bool,
    when: string,
}

export struct ModItem {
    id: string,
    name: string,
    author: string,
    version: string,
    // 0 unknown, 1 Nexus, 2 Thunderstore.
    source: int,
    update: string,
    page: string,
    icon: image,
    has-icon: bool,
    enabled: bool,
}

// A search result in "Browse".
export struct BrowseItem {
    id: string,
    name: string,
    author: string,
    summary: string,
    version: string,
    downloads: string,
    icon: image,
    has-icon: bool,
    // 0 not installed, 1 installed, 2 update available, 3 similar mod installed.
    state: int,
    // Similar mod installed / dependencies, in a line under the summary.
    note: string,
    page: string,
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 32px;
    height: 18px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.line.brighter(0.35);
    animate background { duration: 120ms; }
    Rectangle {
        width: parent.height - 6px;
        height: self.width;
        y: 3px;
        x: on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: on ? Theme.on-accent : Theme.dim;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    opacity: enabled ? 1 : 0.5;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
                        : (ta.has-hover ? #ffffff1c : #ffffff10);
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if icon.width > 0: Image {
            source: icon;
            width: 14px;
            colorize: primary ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: primary ? Theme.on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// Own search field (the stock LineEdit stood out: blue line, square corners).
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line.brighter(0.5) : Theme.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            source: @image-url("icons/search.svg");
            width: 13px;
            colorize: Theme.faint;
            vertical-alignment: center;
        }
        Rectangle {
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }
            if root.text == "": Text {
                text: @tr("Search mods");
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
                x: 0;
            }
        }
        if root.text != "": Text {
            text: "×";
            color: clear.has-hover ? Theme.text : Theme.faint;
            font-size: 15px;
            vertical-alignment: center;
            clear := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }
    }
}

// Choice among a few options (filter, theme).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);
    height: 30px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    min-width: seg.preferred-width;
    horizontal-stretch: 0;
    seg := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: 4px;
            background: i == root.current ? Theme.hover.brighter(0.3) : (ta.has-hover ? #ffffff08 : transparent);
            min-width: t.preferred-width + 20px;
            t := Text {
                text: o;
                color: i == root.current ? Theme.text : Theme.dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

component GameRow inherits Rectangle {
    in property <GameItem> game;
    in property <bool> selected;
    callback clicked;
    height: 46px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff07 : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            clip: true;
            background: Theme.line;
            Image {
                source: root.game.icon;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: game.name;
                color: selected ? Theme.text : Theme.text.darker(0.15);
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: game.loader;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToastCard inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <bool> closable: true;
    callback close;
    height: lay.preferred-height;
    border-radius: 8px;
    background: Theme.raised;
    border-width: 1px;
    border-color: error ? Theme.error.transparentize(0.5) : Theme.line;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    lay := HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.error ? Theme.error : Theme.faint;
        }
        Text {
            text: root.text;
            color: root.error ? Theme.error : Theme.text;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.closable: Text {
            text: "×";
            color: x.has-hover ? Theme.text : Theme.faint;
            font-size: 16px;
            vertical-alignment: center;
            x := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
        }
    }
}

component BellButton inherits Rectangle {
    in property <int> count;
    in property <bool> active;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: Theme.radius;
    background: active || ta.has-hover ? #ffffff10 : transparent;
    Image {
        source: @image-url("icons/bell.svg");
        width: 15px;
        colorize: root.active ? Theme.text : Theme.dim;
    }
    if root.count > 0: Rectangle {
        x: 16px;
        y: 2px;
        height: 15px;
        width: max(15px, badge.preferred-width + 8px);
        border-radius: 7.5px;
        background: Theme.accent;
        badge := Text {
            text: root.count > 9 ? "9+" : root.count;
            color: Theme.on-accent;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SideLink inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff07 : transparent);
    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 14px;
            colorize: root.selected ? Theme.text : Theme.dim;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: selected ? Theme.text : Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component GroupLabel inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

component LinkText inherits Text {
    callback clicked;
    color: lta.has-hover ? Theme.text : Theme.accent;
    font-size: 12px;
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Column widths of the list (header and rows use the same).
global Cols {
    out property <length> author: 200px;
    out property <length> version: 110px;
    out property <length> remove: 130px;
    out property <length> toggle: 40px;
}

export struct PropRow {
    label: string,
    value: string,
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: ta.has-hover ? #ffffff10 : transparent;
    Text {
        x: 10px;
        text: root.text;
        color: root.danger ? Theme.error : Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        height: parent.height;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ModRow inherits Rectangle {
    in property <ModItem> item;
    in property <bool> show-author;
    callback toggled(bool);
    callback remove();
    callback open-url(string);
    callback open-folder();
    callback properties();
    callback update();
    property <length> menu-x;
    property <length> menu-y;
    // First click on "Remove" asks for confirmation; it goes away by itself after 3 s.
    property <bool> confirm;
    property <bool> hovered: ta.has-hover || rm.has-hover;
    height: 44px;
    border-radius: Theme.radius;
    background: hovered ? #ffffff06 : transparent;
    // Right click: the mod's menu.
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 210px;
        Rectangle {
            border-radius: 8px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            VerticalLayout {
                padding: 5px;
                spacing: 1px;
                MenuItem {
                    text: root.item.enabled ? @tr("Disable") : @tr("Enable");
                    clicked => { root.toggled(!root.item.enabled); }
                }
                MenuItem {
                    text: @tr("Show in folder");
                    clicked => { root.open-folder(); }
                }
                if root.item.page != "": MenuItem {
                    text: @tr("Open mod page");
                    clicked => { root.open-url(root.item.page); }
                }
                MenuItem {
                    text: @tr("Properties");
                    clicked => { root.properties(); }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                }
                MenuItem {
                    text: @tr("Move to trash");
                    danger: true;
                    clicked => { root.remove(); }
                }
            }
        }
    }
    Timer {
        interval: 3s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                clip: true;
                background: Theme.surface;
                if item.has-icon: Image {
                    source: item.icon;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: item.enabled ? 1 : 0.45;
                }
                if !item.has-icon: Image {
                    source: @image-url("icons/puzzle.svg");
                    width: 13px;
                    colorize: Theme.faint;
                }
            }
            Text {
                text: item.name;
                color: item.enabled ? Theme.text : Theme.faint;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 0;
                max-width: self.preferred-width;
            }
            Image {
                source: item.source == 1 ? @image-url("icons/nexus.svg") : item.source == 2 ? @image-url("icons/thunderstore.svg") : @image-url("icons/unknown.svg");
                width: 13px;
                y: (parent.height - self.height) / 2;
                colorize: item.source == 1 ? Theme.nexus : item.source == 2 ? Theme.thunderstore : Theme.faint;
                opacity: item.enabled ? (item.source == 0 ? 0.7 : 0.85) : 0.4;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.show-author: Text {
            width: Cols.author;
            text: item.author;
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        if item.update == "": Text {
            width: Cols.version;
            text: item.version;
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        if item.update != "": Rectangle {
            width: Cols.version;
            Text {
                x: 0;
                height: parent.height;
                text: item.version + " → " + item.update;
                color: up.has-hover ? Theme.text : Theme.accent;
                font-size: 12px;
                overflow: elide;
                width: parent.width;
                vertical-alignment: center;
            }
            up := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.update(); }
            }
        }
        Rectangle {
            width: Cols.remove;
            Text {
                x: parent.width - self.width;
                text: root.confirm ? @tr("Confirm removal") : @tr("Remove");
                color: root.confirm ? Theme.error : (rm.has-hover ? Theme.text : Theme.faint);
                font-size: 12px;
                vertical-alignment: center;
                height: parent.height;
                opacity: root.hovered || root.confirm ? 1 : 0;
                animate opacity { duration: 100ms; }
            }
            rm := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.confirm {
                        root.confirm = false;
                        root.remove();
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
        Rectangle {
            width: Cols.toggle;
            Toggle {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                on: item.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;
    in property <bool> wallust-available;
    in property <string> wallust-path;
    in-out property <int> theme-mode;
    in-out property <int> lang-mode;
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    callback theme-changed(int);
    callback lang-changed(int);
    padding: 36px;
    padding-top: 32px;
    spacing: 8px;
    alignment: start;

    Text {
        text: @tr("Settings");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Rectangle { height: 18px; }

    GroupLabel { text: "NEXUS MODS"; }
    Text {
        text: @tr("API key");
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 420px;
            height: 32px;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: key.has-focus ? Theme.line.brighter(0.5) : Theme.line;
            key := TextInput {
                x: 10px;
                width: parent.width - 20px;
                input-type: password;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    if self.text != "" && !root.key-busy {
                        root.save-key(self.text);
                        self.text = "";
                    }
                }
            }
            if key.text == "": Text {
                x: 10px;
                text: root.nexus-ok ? @tr("Key saved. Paste another one to replace it.") : @tr("Paste your key here");
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        Button {
            text: root.key-busy ? @tr("Checking…") : @tr("Save");
            primary: true;
            clicked => {
                if key.text != "" && !root.key-busy {
                    root.save-key(key.text);
                    key.text = "";
                }
            }
        }
        if root.nexus-ok: Button {
            text: @tr("Delete key");
            clicked => { root.clear-key(); }
        }
    }
    Text {
        text: root.nexus-status;
        color: root.nexus-ok ? Theme.dim : Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.nexus-ok: LinkText {
        text: @tr("Get your key at nexusmods.com (Settings → API Keys, at the bottom of the page)");
        clicked => { root.open-key-page(); }
    }

    Rectangle { height: 22px; }
    GroupLabel { text: @tr("WEBSITE LINKS"); }
    Text {
        text: @tr("Open the download buttons of the Nexus (\"Mod Manager Download\") and Thunderstore (\"Install with Mod Manager\") in linex-mods");
        color: Theme.text;
    }
    if root.handler-ok: Text {
        text: @tr("Active.");
        color: Theme.dim;
        font-size: 12px;
    }
    if !root.handler-ok: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("Turn on");
            clicked => { root.register-handler(); }
        }
    }
    Text {
        text: @tr("The first time, your browser asks which program opens the link: pick linex-mods.");
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }

    Rectangle { height: 22px; }
    GroupLabel { text: @tr("LANGUAGE"); }
    HorizontalLayout {
        alignment: start;
        Segmented {
            options: [@tr("Automatic"), "English", "Português"];
            current <=> root.lang-mode;
            changed(i) => { root.lang-changed(i); }
        }
    }

    Rectangle { height: 22px; }
    GroupLabel { text: @tr("APPEARANCE"); }
    Text {
        text: @tr("Colors");
        color: Theme.text;
    }
    HorizontalLayout {
        alignment: start;
        Segmented {
            options: root.wallust-available ? [@tr("Default"), @tr("From wallpaper (wallust)")] : [@tr("Default")];
            current <=> root.theme-mode;
            changed(i) => { root.theme-changed(i); }
        }
    }
    Text {
        text: root.wallust-available
            ? @tr("Read from {}. Follows your wallpaper.", root.wallust-path)
            : @tr("No wallust palette found: the wallpaper theme shows up here once a palette exists.");
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component AddGamePage inherits VerticalLayout {
    in property <[UnityItem]> games;
    in property <int> installing: -1;
    callback install(int, string);
    padding: 36px;
    padding-top: 32px;
    spacing: 8px;

    Text {
        text: @tr("Add game");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Unity games from Steam that don't have a mod loader yet. Pick the one the game's mods ask for: each mod page says whether it uses MelonLoader or BepInEx.");
        color: Theme.dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    Rectangle { height: 12px; }
    if root.games.length == 0: Text {
        text: @tr("No Unity games without a loader found.");
        color: Theme.faint;
        font-size: 13px;
    }
    ScrollView {
        VerticalLayout {
            spacing: 2px;
            for g in root.games: Rectangle {
                height: 52px;
                border-radius: Theme.radius;
                background: ta.has-hover ? #ffffff06 : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        clip: true;
                        background: Theme.line;
                        Image {
                            source: g.icon;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: g.name;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                        Text {
                            text: g.kind;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                    if root.installing == g.appid: Text {
                        text: @tr("Installing…");
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.installing != g.appid: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "MelonLoader";
                                enabled: root.installing < 0;
                                clicked => { root.install(g.appid, "melonloader"); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "BepInEx";
                                enabled: root.installing < 0;
                                clicked => { root.install(g.appid, "bepinex"); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Tab under the game header ("Mods", "Browse"): text, underlined when selected.
component TabLink inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    width: label.preferred-width;
    height: 30px;
    label := Text {
        y: 0;
        height: parent.height - 2px;
        text: root.text;
        color: root.selected ? Theme.text : (ta.has-hover ? Theme.dim : Theme.faint);
        font-size: 14px;
        font-weight: root.selected ? 700 : 500;
        vertical-alignment: center;
    }
    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Site button in "Browse": the site's mark and name.
component SourceButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> mark;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    width: lay.preferred-width;
    border-radius: Theme.radius;
    background: root.selected ? #ffffff14 : (ta.has-hover ? #ffffff0a : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.line.brighter(0.6) : Theme.line;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            source: root.icon;
            width: 15px;
            colorize: root.selected ? root.mark : Theme.faint;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.dim;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BrowseRow inherits Rectangle {
    in property <BrowseItem> item;
    in property <bool> nexus;
    callback install();
    callback open-url(string);
    height: 64px;
    border-radius: Theme.radius;
    background: ta.has-hover ? #ffffff06 : transparent;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            clip: true;
            background: Theme.surface;
            if item.has-icon: Image {
                source: item.icon;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !item.has-icon: Image {
                source: @image-url("icons/puzzle.svg");
                width: 16px;
                colorize: Theme.faint;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.name;
                    color: name-ta.has-hover ? Theme.accent : Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    name-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-url(item.page); }
                    }
                }
                Text {
                    text: item.author != "" ? @tr("by {}", item.author) : "";
                    color: Theme.faint;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            Text {
                text: item.summary;
                color: Theme.dim;
                font-size: 12px;
                overflow: elide;
            }
            if item.note != "": Text {
                text: item.note;
                color: item.state == 3 ? Theme.warn : Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text {
            width: 90px;
            text: item.downloads;
            color: Theme.faint;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 120px;
            if item.state == 1: Text {
                x: parent.width - self.width;
                height: parent.height;
                text: @tr("Installed");
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
            }
            if item.state != 1: Button {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                text: item.state == 2 ? @tr("Update") : root.nexus ? @tr("Download") : @tr("Install");
                primary: item.state == 2;
                clicked => { root.install(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "linex-mods";
    preferred-width: 1180px;
    preferred-height: 740px;
    min-width: 820px;
    min-height: 500px;
    background: Theme.bg;
    default-font-size: 13px;

    in property <[GameItem]> games;
    in property <[ModItem]> mods;
    in-out property <int> current: -1;
    in property <string> game-name;
    in property <string> game-status;
    in property <bool> game-warning;
    in property <string> game-fix;
    in property <string> game-missing-loader;
    in property <[UnityItem]> unity-games;
    in property <int> installing: -1;
    in property <string> counts;
    in property <image> hero;
    in property <image> logo;
    in property <bool> show-author;
    in property <[Notice]> toasts;
    in property <[Notice]> notices;
    in property <int> unseen;
    in property <string> progress;
    in-out property <bool> panel-open;
    in property <bool> drop-hover;
    in-out property <bool> sort-desc;
    in property <bool> checking;
    // Thunderstore mods with a newer version (they update in one click).
    in property <int> ts-updates;
    in-out property <bool> props-open;
    in property <string> props-title;
    in property <[PropRow]> props;
    in property <bool> busy;
    in-out property <string> filter;
    in-out property <int> filter-mode;
    in-out property <int> page;
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;
    in property <bool> wallust-available;
    in property <string> wallust-path;
    in-out property <int> theme-mode;
    in-out property <int> lang-mode;
    // Game page: 0 its mods, 1 browse.
    in-out property <int> game-tab;
    in property <bool> has-nexus;
    in property <bool> has-thunderstore;
    // 1 Nexus, 2 Thunderstore.
    in-out property <int> browse-source: 1;
    in-out property <string> browse-query;
    in-out property <int> browse-sort;
    in-out property <bool> browse-hidden;
    in property <[BrowseItem]> browse-items;
    in property <string> browse-status;
    in property <bool> browse-loading;
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button;

    callback select-game(int);
    callback toggle-mod(string, bool);
    callback remove-mod(string);
    callback add-mod();
    callback play();
    callback open-folder();
    callback copy-fix();
    callback show-add-game();
    callback install-loader(int, string);
    callback loader-finished(int, string, bool);
    callback open-url(string);
    callback updates-found(int, string);
    callback filter-changed(string);
    callback show-settings();
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    callback theme-changed(int);
    callback lang-changed(int);
    callback open-mod-folder(string);
    callback show-properties(string);
    callback check-updates();
    callback update-mod(string);
    callback update-all();
    callback nxm-received(string);
    callback open-panel();
    callback clear-notices();
    callback dismiss-toast(int);
    callback nxm-finished(int, string, bool);
    callback browse-search();
    callback browse-query-edited(string);
    callback browse-install(string);
    callback browse-results(int, string, string);
    callback browse-icons(int);
    callback confirm-accept();

    HorizontalLayout {
        // Barra lateral: jogos.
        Rectangle {
            width: 248px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                padding-top: 20px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        text: "linex-mods";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    BellButton {
                        count: root.unseen;
                        active: root.panel-open;
                        clicked => {
                            root.panel-open = !root.panel-open;
                            if root.panel-open { root.open-panel(); }
                        }
                    }
                }
                Rectangle { height: 18px; }
                GroupLabel {
                    text: @tr("GAMES");
                    x: 10px;
                }
                Rectangle { height: 6px; }
                for g[i] in root.games: GameRow {
                    game: g;
                    selected: i == root.current && root.page == 0;
                    clicked => {
                        root.page = 0;
                        root.current = i;
                        root.select-game(i);
                    }
                }
                if root.games.length == 0: Text {
                    x: 10px;
                    text: @tr("No games with a mod loader found.");
                    color: Theme.faint;
                    wrap: word-wrap;
                }
                Rectangle { }
                SideLink {
                    text: @tr("Add game");
                    icon: @image-url("icons/plus.svg");
                    selected: root.page == 2;
                    clicked => {
                        root.page = 2;
                        root.show-add-game();
                    }
                }
                SideLink {
                    text: @tr("Settings");
                    icon: @image-url("icons/gear.svg");
                    selected: root.page == 1;
                    clicked => {
                        root.page = 1;
                        root.show-settings();
                    }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            SettingsPage {
                nexus-status: root.nexus-status;
                nexus-ok: root.nexus-ok;
                key-busy: root.key-busy;
                handler-ok: root.handler-ok;
                wallust-available: root.wallust-available;
                wallust-path: root.wallust-path;
                theme-mode <=> root.theme-mode;
                lang-mode <=> root.lang-mode;
                lang-changed(i) => { root.lang-changed(i); }
                save-key(k) => { root.save-key(k); }
                clear-key => { root.clear-key(); }
                register-handler => { root.register-handler(); }
                open-key-page => { root.open-key-page(); }
                theme-changed(i) => { root.theme-changed(i); }
            }
            Rectangle { }
        }

        if root.page == 2: AddGamePage {
            games: root.unity-games;
            installing: root.installing;
            install(id, l) => { root.install-loader(id, l); }
        }

        if root.page == 0: VerticalLayout {
            // Header in the style of Steam's library: game art fading into the background.
            // Lower while browsing, so more results fit.
            Rectangle {
                height: root.game-tab == 1 ? 150px : 210px;
                animate height { duration: 150ms; easing: ease-out; }
                clip: true;
                background: Theme.surface;
                Image {
                    source: root.hero;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: 0.7;
                }
                Rectangle {
                    background: @linear-gradient(180deg, Theme.bg.transparentize(0.85) 0%, Theme.bg.transparentize(0.35) 55%, Theme.bg 100%);
                }
                Rectangle {
                    background: @linear-gradient(90deg, Theme.bg.transparentize(0.25) 0%, Theme.bg.transparentize(1) 60%);
                }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-bottom: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.logo.width > 0: Image {
                            source: root.logo;
                            height: 84px;
                            image-fit: contain;
                            horizontal-alignment: left;
                        }
                        if root.logo.width == 0: Text {
                            text: root.game-name;
                            color: Theme.text;
                            font-size: 28px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.game-status;
                                color: root.game-warning ? Theme.warn : Theme.dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                                max-width: self.preferred-width;
                            }
                            if root.game-fix != "": LinkText {
                                text: @tr("Copy option");
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                                clicked => { root.copy-fix(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.game-missing-loader != "": Button {
                                text: root.installing >= 0 ? @tr("Installing…") : @tr("Install {}", root.game-missing-loader);
                                enabled: root.installing < 0;
                                clicked => {
                                    root.install-loader(root.games[root.current].appid, root.game-missing-loader);
                                }
                            }
                            Button {
                                text: @tr("Open folder");
                                icon: @image-url("icons/folder.svg");
                                clicked => { root.open-folder(); }
                            }
                            Button {
                                text: root.busy ? @tr("Installing…") : @tr("Add mod");
                                icon: @image-url("icons/plus.svg");
                                enabled: !root.busy;
                                clicked => { root.add-mod(); }
                            }
                            Button {
                                text: @tr("Play");
                                icon: @image-url("icons/play.svg");
                                primary: true;
                                clicked => { root.play(); }
                            }
                        }
                    }
                }
            }

            // Tabs: the game's mods, or browse the mod sites.
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 14px;
                spacing: 22px;
                TabLink {
                    text: @tr("Mods");
                    selected: root.game-tab == 0;
                    clicked => { root.game-tab = 0; }
                }
                TabLink {
                    text: @tr("Browse");
                    selected: root.game-tab == 1;
                    clicked => {
                        root.game-tab = 1;
                        root.browse-search();
                    }
                }
                Rectangle { }
            }

            if root.game-tab == 0: VerticalLayout {
            // List bar: search, filter and count.
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 4px;
                padding-bottom: 12px;
                spacing: 12px;
                SearchBox {
                    width: 300px;
                    text <=> root.filter;
                    edited(t) => { root.filter-changed(t); }
                }
                Segmented {
                    options: [@tr("All"), @tr("Enabled"), @tr("Disabled")];
                    current <=> root.filter-mode;
                    changed => { root.filter-changed(root.filter); }
                }
                Button {
                    height: 30px;
                    text: root.checking ? @tr("Checking…") : @tr("Check for updates");
                    icon: @image-url("icons/refresh.svg");
                    enabled: !root.checking;
                    clicked => { root.check-updates(); }
                }
                if root.ts-updates > 0: Button {
                    height: 30px;
                    text: @tr("Update all ({})", root.ts-updates);
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.update-all(); }
                }
                Rectangle { }
                Text {
                    text: root.counts;
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Column header.
            HorizontalLayout {
                padding-left: 40px;
                padding-right: 40px;
                spacing: 16px;
                height: 24px;
                Rectangle {
                    width: sort-label.preferred-width;
                    horizontal-stretch: 0;
                    sort-label := GroupLabel {
                        text: root.sort-desc ? "MOD  ↓" : "MOD  ↑";
                        color: sort-ta.has-hover ? Theme.text : Theme.faint;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    sort-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sort-desc = !root.sort-desc;
                            root.filter-changed(root.filter);
                        }
                    }
                }
                Rectangle { }
                if root.show-author: GroupLabel { width: Cols.author; text: @tr("AUTHOR"); vertical-alignment: center; }
                GroupLabel { width: Cols.version; text: @tr("VERSION"); vertical-alignment: center; }
                Rectangle { width: Cols.remove; }
                GroupLabel { width: Cols.toggle; text: @tr("ON"); vertical-alignment: center; horizontal-alignment: right; }
            }
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
            }

            // List with the scrollbar on the left (near the names, where the eye already is).
            HorizontalLayout {
                Rectangle {
                    width: 28px;
                    track := Rectangle {
                        property <length> max-scroll: flick.content-height - flick.height;
                        x: 10px;
                        y: 6px;
                        width: drag.has-hover || drag.pressed ? 8px : 6px;
                        animate width { duration: 100ms; }
                        height: parent.height - 12px;
                        visible: self.max-scroll > 0;
                        border-radius: self.width / 2;
                        background: drag.has-hover || drag.pressed ? Theme.line : Theme.line.transparentize(0.5);
                        thumb := Rectangle {
                            width: parent.width;
                            height: max(40px, parent.height * flick.height / max(flick.content-height, 1px));
                            y: track.max-scroll > 0 ? (-flick.content-y / track.max-scroll) * (parent.height - self.height) : 0;
                            border-radius: self.width / 2;
                            background: drag.pressed ? Theme.dim : (drag.has-hover ? Theme.faint.brighter(0.4) : Theme.faint);
                        }
                        drag := TouchArea {
                            mouse-cursor: pointer;
                            function jump() {
                                flick.content-y = -max(0, min(1, (self.mouse-y - thumb.height / 2) / max(1px, track.height - thumb.height))) * track.max-scroll;
                            }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                    self.jump();
                                }
                            }
                            moved => {
                                if self.pressed { self.jump(); }
                            }
                            scroll-event(e) => {
                                flick.content-y = max(-track.max-scroll, min(0, flick.content-y + e.delta-y));
                                accept
                            }
                        }
                    }
                }
                flick := Flickable {
                    content-height: list.preferred-height;
                    content-width: self.width;
                    list := VerticalLayout {
                    width: flick.width;
                    padding-right: 28px;
                    padding-top: 4px;
                    padding-bottom: 16px;
                    for m in root.mods: ModRow {
                        item: m;
                        show-author: root.show-author;
                        toggled(v) => { root.toggle-mod(m.id, v); }
                        remove => { root.remove-mod(m.id); }
                        open-url(u) => { root.open-url(u); }
                        open-folder => { root.open-mod-folder(m.id); }
                        properties => { root.show-properties(m.id); }
                        update => { root.update-mod(m.id); }
                    }
                    if root.mods.length == 0 && root.current >= 0: Text {
                        text: root.filter != "" ? @tr("No mod with that name.")
                            : root.filter-mode != 0 ? @tr("No mods here.")
                            : @tr("No mods installed. Use \"Add mod\", the Nexus \"Mod Manager Download\" button, or drop a file here.");
                        color: Theme.faint;
                        horizontal-alignment: center;
                        height: 100px;
                        vertical-alignment: center;
                    }
                    }
                }
            }
            }

            if root.game-tab == 1: VerticalLayout {
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 4px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    if root.has-nexus: SourceButton {
                        text: "Nexus Mods";
                        icon: @image-url("icons/nexus.svg");
                        mark: Theme.nexus;
                        selected: root.browse-source == 1;
                        clicked => {
                            root.browse-source = 1;
                            root.browse-search();
                        }
                    }
                    if root.has-thunderstore: SourceButton {
                        text: "Thunderstore";
                        icon: @image-url("icons/thunderstore.svg");
                        mark: Theme.thunderstore;
                        selected: root.browse-source == 2;
                        clicked => {
                            root.browse-source = 2;
                            root.browse-search();
                        }
                    }
                    SearchBox {
                        width: 240px;
                        text <=> root.browse-query;
                        edited(t) => { root.browse-query-edited(t); }
                    }
                    Segmented {
                        options: [@tr("Popular"), @tr("Updated"), @tr("Name")];
                        current <=> root.browse-sort;
                        changed => { root.browse-search(); }
                    }
                    Rectangle { }
                    LinkText {
                        text: root.browse-hidden ? @tr("Hide adult and deprecated") : @tr("Show adult and deprecated");
                        font-size: 12px;
                        vertical-alignment: center;
                        clicked => {
                            root.browse-hidden = !root.browse-hidden;
                            root.browse-search();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                }
                if root.browse-status != "" || root.browse-loading: Text {
                    text: root.browse-loading ? @tr("Searching…") : root.browse-status;
                    color: Theme.faint;
                    horizontal-alignment: center;
                    height: 80px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if !root.browse-loading: ScrollView {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        padding-bottom: 16px;
                        for b in root.browse-items: BrowseRow {
                            item: b;
                            nexus: root.browse-source == 1;
                            install => { root.browse-install(b.id); }
                            open-url(u) => { root.open-url(u); }
                        }
                    }
                }
            }
        }
    }

    // Properties of a mod (right click → Properties).
    if root.props-open: Rectangle {
        background: #00000070;
        TouchArea {
            clicked => { root.props-open = false; }
        }
        Rectangle {
            width: min(560px, parent.width - 80px);
            height: min(props-lay.preferred-height, parent.height - 80px);
            border-radius: 12px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000080;
            clip: true;
            TouchArea { }
            props-lay := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    Text {
                        text: root.props-title;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "×";
                        color: px.has-hover ? Theme.text : Theme.faint;
                        font-size: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        px := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.props-open = false; }
                        }
                    }
                }
                for r in root.props: VerticalLayout {
                    spacing: 2px;
                    GroupLabel { text: r.label; }
                    Text {
                        text: r.value;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Confirmation before installing (dependencies, a similar mod already installed).
    if root.confirm-open: Rectangle {
        background: #00000070;
        TouchArea {
            clicked => { root.confirm-open = false; }
        }
        Rectangle {
            width: min(520px, parent.width - 80px);
            height: confirm-lay.preferred-height;
            border-radius: 12px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000080;
            TouchArea { }
            confirm-lay := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.confirm-title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-open = false; }
                    }
                    Button {
                        text: root.confirm-button;
                        primary: true;
                        clicked => {
                            root.confirm-open = false;
                            root.confirm-accept();
                        }
                    }
                }
            }
        }
    }

    // Arquivo sendo arrastado sobre a janela.
    if root.drop-hover: Rectangle {
        background: Theme.bg.transparentize(0.12);
        Rectangle {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: parent.height - 40px;
            border-radius: 14px;
            border-width: 2px;
            border-color: Theme.accent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.page == 0 && root.game-name != "" ? @tr("Drop to install in {}", root.game-name) : @tr("Open a game to install");
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr(".zip, .7z or .rar files");
                    color: Theme.dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Notices stacked in the top right corner. Rust removes each one after 2.5 s;
    // the progress one stays while it lasts.
    VerticalLayout {
        x: parent.width - self.width - 20px;
        y: 20px;
        width: 380px;
        height: self.preferred-height;
        spacing: 8px;
        if root.progress != "": ToastCard {
            text: root.progress;
            closable: false;
        }
        for t in root.toasts: ToastCard {
            text: t.text;
            error: t.error;
            close => { root.dismiss-toast(t.id); }
        }
    }

    // Notice history (opened from the bell).
    if root.panel-open: TouchArea {
        clicked => { root.panel-open = false; }
    }
    if root.panel-open: Rectangle {
        x: 16px;
        y: 56px;
        width: 380px;
        height: root.notices.length == 0 ? 110px : min(460px, root.height - 80px, 64px + root.notices.length * 56px);
        border-radius: 10px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { }
        VerticalLayout {
            padding: 14px;
            padding-bottom: 8px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: @tr("Notifications");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                if root.notices.length > 0: LinkText {
                    text: @tr("Clear");
                    vertical-alignment: center;
                    clicked => { root.clear-notices(); }
                }
            }
            if root.notices.length == 0: Text {
                text: @tr("Nothing here.");
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                height: 48px;
            }
            if root.notices.length > 0: ScrollView {
                VerticalLayout {
                    spacing: 2px;
                    for n in root.notices: Rectangle {
                        border-radius: 6px;
                        background: ta.has-hover ? #ffffff06 : transparent;
                        ta := TouchArea { }
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                y: 6px;
                                border-radius: 3px;
                                background: n.error ? Theme.error : Theme.faint;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: n.text;
                                    color: n.error ? Theme.error : Theme.text;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: n.when;
                                    color: Theme.faint;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
