import { ScrollView } from "std-widgets.slint";

// Cores da interface. O Rust troca todas de uma vez (tema padrão ou wallust).
export global Theme {
    in-out property <color> bg: #121418;
    in-out property <color> sidebar: #0d0f12;
    in-out property <color> surface: #181b20;
    in-out property <color> raised: #1d2026;
    in-out property <color> hover: #1e2228;
    in-out property <color> line: #24282f;
    in-out property <color> text: #e4e6ea;
    in-out property <color> dim: #8a919b;
    in-out property <color> faint: #5c636d;
    in-out property <color> accent: #4d8eff;
    in-out property <color> on-accent: #ffffff;
    in-out property <color> warn: #e0b04a;
    in-out property <color> error: #e5534b;
    out property <length> radius: 6px;
}

export struct GameItem {
    appid: int,
    name: string,
    loader: string,
    icon: image,
}

export struct UnityItem {
    appid: int,
    name: string,
    kind: string,
    icon: image,
}

export struct Notice {
    id: int,
    text: string,
    error: bool,
    when: string,
}

export struct ModItem {
    id: string,
    name: string,
    author: string,
    version: string,
    source: string,
    update: string,
    page: string,
    icon: image,
    has-icon: bool,
    enabled: bool,
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 32px;
    height: 18px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.line.brighter(0.35);
    animate background { duration: 120ms; }
    Rectangle {
        width: parent.height - 6px;
        height: self.width;
        y: 3px;
        x: on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: on ? Theme.on-accent : Theme.dim;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    opacity: enabled ? 1 : 0.5;
    background: primary ? (ta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
                        : (ta.has-hover ? #ffffff1c : #ffffff10);
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if icon.width > 0: Image {
            source: icon;
            width: 14px;
            colorize: primary ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: primary ? Theme.on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// Campo de busca próprio (o LineEdit padrão destoava: linha azul, cantos retos).
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line.brighter(0.5) : Theme.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            source: @image-url("icons/search.svg");
            width: 13px;
            colorize: Theme.faint;
            vertical-alignment: center;
        }
        Rectangle {
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }
            if root.text == "": Text {
                text: "Buscar mod";
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
                x: 0;
            }
        }
        if root.text != "": Text {
            text: "×";
            color: clear.has-hover ? Theme.text : Theme.faint;
            font-size: 15px;
            vertical-alignment: center;
            clear := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }
    }
}

// Escolha entre poucas opções (filtro, tema).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);
    height: 30px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    min-width: seg.preferred-width;
    horizontal-stretch: 0;
    seg := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: 4px;
            background: i == root.current ? Theme.hover.brighter(0.3) : (ta.has-hover ? #ffffff08 : transparent);
            min-width: t.preferred-width + 20px;
            t := Text {
                text: o;
                color: i == root.current ? Theme.text : Theme.dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

component GameRow inherits Rectangle {
    in property <GameItem> game;
    in property <bool> selected;
    callback clicked;
    height: 46px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff07 : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            clip: true;
            background: Theme.line;
            Image {
                source: root.game.icon;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: game.name;
                color: selected ? Theme.text : Theme.text.darker(0.15);
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: game.loader;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToastCard inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <bool> closable: true;
    callback close;
    height: lay.preferred-height;
    border-radius: 8px;
    background: Theme.raised;
    border-width: 1px;
    border-color: error ? Theme.error.transparentize(0.5) : Theme.line;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    lay := HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.error ? Theme.error : Theme.faint;
        }
        Text {
            text: root.text;
            color: root.error ? Theme.error : Theme.text;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.closable: Text {
            text: "×";
            color: x.has-hover ? Theme.text : Theme.faint;
            font-size: 16px;
            vertical-alignment: center;
            x := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
        }
    }
}

component BellButton inherits Rectangle {
    in property <int> count;
    in property <bool> active;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: Theme.radius;
    background: active || ta.has-hover ? #ffffff10 : transparent;
    Image {
        source: @image-url("icons/bell.svg");
        width: 15px;
        colorize: root.active ? Theme.text : Theme.dim;
    }
    if root.count > 0: Rectangle {
        x: 16px;
        y: 2px;
        height: 15px;
        width: max(15px, badge.preferred-width + 8px);
        border-radius: 7.5px;
        background: Theme.accent;
        badge := Text {
            text: root.count > 9 ? "9+" : root.count;
            color: Theme.on-accent;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SideLink inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius;
    background: selected ? Theme.hover : (ta.has-hover ? #ffffff07 : transparent);
    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 14px;
            colorize: root.selected ? Theme.text : Theme.dim;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: selected ? Theme.text : Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component GroupLabel inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

component LinkText inherits Text {
    callback clicked;
    color: lta.has-hover ? Theme.text : Theme.accent;
    font-size: 12px;
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Larguras das colunas da lista (cabeçalho e linhas usam as mesmas).
global Cols {
    out property <length> author: 200px;
    out property <length> version: 110px;
    out property <length> remove: 130px;
    out property <length> toggle: 40px;
}

component ModRow inherits Rectangle {
    in property <ModItem> item;
    in property <bool> show-author;
    callback toggled(bool);
    callback remove();
    callback open-url(string);
    // Primeiro clique em "Remover" pede confirmação; some sozinho em 3 s.
    property <bool> confirm;
    property <bool> hovered: ta.has-hover || rm.has-hover;
    height: 44px;
    border-radius: Theme.radius;
    background: hovered ? #ffffff06 : transparent;
    ta := TouchArea { }
    Timer {
        interval: 3s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                clip: true;
                background: Theme.surface;
                if item.has-icon: Image {
                    source: item.icon;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: item.enabled ? 1 : 0.45;
                }
                if !item.has-icon: Image {
                    source: @image-url("icons/puzzle.svg");
                    width: 13px;
                    colorize: Theme.faint;
                }
            }
            Text {
                text: item.name;
                color: item.enabled ? Theme.text : Theme.faint;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 0;
                max-width: self.preferred-width;
            }
            if item.source != "": Text {
                text: item.source;
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.show-author: Text {
            width: Cols.author;
            text: item.author;
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        if item.update == "": Text {
            width: Cols.version;
            text: item.version;
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        if item.update != "": Rectangle {
            width: Cols.version;
            Text {
                x: 0;
                height: parent.height;
                text: item.version + " → " + item.update;
                color: up.has-hover ? Theme.text : Theme.accent;
                font-size: 12px;
                overflow: elide;
                width: parent.width;
                vertical-alignment: center;
            }
            up := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-url(item.page); }
            }
        }
        Rectangle {
            width: Cols.remove;
            Text {
                x: parent.width - self.width;
                text: root.confirm ? "Confirmar remoção" : "Remover";
                color: root.confirm ? Theme.error : (rm.has-hover ? Theme.text : Theme.faint);
                font-size: 12px;
                vertical-alignment: center;
                height: parent.height;
                opacity: root.hovered || root.confirm ? 1 : 0;
                animate opacity { duration: 100ms; }
            }
            rm := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.confirm {
                        root.confirm = false;
                        root.remove();
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
        Rectangle {
            width: Cols.toggle;
            Toggle {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                on: item.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;
    in property <bool> wallust-available;
    in property <string> wallust-path;
    in-out property <int> theme-mode;
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    callback theme-changed(int);
    padding: 36px;
    padding-top: 32px;
    spacing: 8px;
    alignment: start;

    Text {
        text: "Configurações";
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Rectangle { height: 18px; }

    GroupLabel { text: "NEXUS MODS"; }
    Text {
        text: "Chave da API";
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 420px;
            height: 32px;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: key.has-focus ? Theme.line.brighter(0.5) : Theme.line;
            key := TextInput {
                x: 10px;
                width: parent.width - 20px;
                input-type: password;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    if self.text != "" && !root.key-busy {
                        root.save-key(self.text);
                        self.text = "";
                    }
                }
            }
            if key.text == "": Text {
                x: 10px;
                text: root.nexus-ok ? "Chave salva. Cole outra para trocar." : "Cole a chave aqui";
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        Button {
            text: root.key-busy ? "Verificando…" : "Salvar";
            primary: true;
            clicked => {
                if key.text != "" && !root.key-busy {
                    root.save-key(key.text);
                    key.text = "";
                }
            }
        }
        if root.nexus-ok: Button {
            text: "Apagar chave";
            clicked => { root.clear-key(); }
        }
    }
    Text {
        text: root.nexus-status;
        color: root.nexus-ok ? Theme.dim : Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.nexus-ok: LinkText {
        text: "Gerar a chave em nexusmods.com (Configurações → API Keys, no fim da página)";
        clicked => { root.open-key-page(); }
    }

    Rectangle { height: 22px; }
    GroupLabel { text: "LINKS DO SITE"; }
    Text {
        text: "Abrir no linex-mods o botão \"Mod Manager Download\" do Nexus";
        color: Theme.text;
    }
    if root.handler-ok: Text {
        text: "Ativo.";
        color: Theme.dim;
        font-size: 12px;
    }
    if !root.handler-ok: HorizontalLayout {
        alignment: start;
        Button {
            text: "Ativar";
            clicked => { root.register-handler(); }
        }
    }
    Text {
        text: "Na primeira vez, o navegador pergunta qual programa abre o link: escolha o linex-mods.";
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }

    Rectangle { height: 22px; }
    GroupLabel { text: "APARÊNCIA"; }
    Text {
        text: "Cores";
        color: Theme.text;
    }
    HorizontalLayout {
        alignment: start;
        Segmented {
            options: root.wallust-available ? ["Padrão", "Do papel de parede (wallust)"] : ["Padrão"];
            current <=> root.theme-mode;
            changed(i) => { root.theme-changed(i); }
        }
    }
    Text {
        text: root.wallust-available
            ? "Lido de " + root.wallust-path + ". Muda junto com o papel de parede."
            : "O wallust não foi encontrado: o tema do papel de parede aparece aqui quando houver uma paleta gerada.";
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component AddGamePage inherits VerticalLayout {
    in property <[UnityItem]> games;
    in property <int> installing: -1;
    callback install(int, string);
    padding: 36px;
    padding-top: 32px;
    spacing: 8px;

    Text {
        text: "Adicionar jogo";
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: "Jogos Unity do Steam que ainda não têm loader de mods. Escolha o que os mods do jogo pedem: a página de cada mod diz se é MelonLoader ou BepInEx.";
        color: Theme.dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    Rectangle { height: 12px; }
    if root.games.length == 0: Text {
        text: "Nenhum jogo Unity sem loader encontrado.";
        color: Theme.faint;
        font-size: 13px;
    }
    ScrollView {
        VerticalLayout {
            spacing: 2px;
            for g in root.games: Rectangle {
                height: 52px;
                border-radius: Theme.radius;
                background: ta.has-hover ? #ffffff06 : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        clip: true;
                        background: Theme.line;
                        Image {
                            source: g.icon;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: g.name;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                        Text {
                            text: g.kind;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                    if root.installing == g.appid: Text {
                        text: "Instalando…";
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.installing != g.appid: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "MelonLoader";
                                enabled: root.installing < 0;
                                clicked => { root.install(g.appid, "melonloader"); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "BepInEx";
                                enabled: root.installing < 0;
                                clicked => { root.install(g.appid, "bepinex"); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "linex-mods";
    preferred-width: 1180px;
    preferred-height: 740px;
    min-width: 820px;
    min-height: 500px;
    background: Theme.bg;
    default-font-size: 13px;

    in property <[GameItem]> games;
    in property <[ModItem]> mods;
    in-out property <int> current: -1;
    in property <string> game-name;
    in property <string> game-status;
    in property <bool> game-warning;
    in property <string> game-fix;
    in property <string> game-missing-loader;
    in property <[UnityItem]> unity-games;
    in property <int> installing: -1;
    in property <string> counts;
    in property <image> hero;
    in property <image> logo;
    in property <bool> show-author;
    in property <[Notice]> toasts;
    in property <[Notice]> notices;
    in property <int> unseen;
    in property <string> progress;
    in-out property <bool> panel-open;
    in property <bool> drop-hover;
    in property <bool> busy;
    in-out property <string> filter;
    in-out property <int> filter-mode;
    in-out property <int> page;
    in property <string> nexus-status;
    in property <bool> nexus-ok;
    in property <bool> key-busy;
    in property <bool> handler-ok;
    in property <bool> wallust-available;
    in property <string> wallust-path;
    in-out property <int> theme-mode;

    callback select-game(int);
    callback toggle-mod(string, bool);
    callback remove-mod(string);
    callback add-mod();
    callback play();
    callback open-folder();
    callback copy-fix();
    callback show-add-game();
    callback install-loader(int, string);
    callback loader-finished(int, string, bool);
    callback open-url(string);
    callback updates-found(int, string);
    callback filter-changed(string);
    callback show-settings();
    callback save-key(string);
    callback clear-key();
    callback register-handler();
    callback open-key-page();
    callback theme-changed(int);
    callback nxm-received(string);
    callback open-panel();
    callback clear-notices();
    callback dismiss-toast(int);
    callback nxm-finished(int, string, bool);

    HorizontalLayout {
        // Barra lateral: jogos.
        Rectangle {
            width: 248px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                padding-top: 20px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        text: "linex-mods";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    BellButton {
                        count: root.unseen;
                        active: root.panel-open;
                        clicked => {
                            root.panel-open = !root.panel-open;
                            if root.panel-open { root.open-panel(); }
                        }
                    }
                }
                Rectangle { height: 18px; }
                GroupLabel {
                    text: "JOGOS";
                    x: 10px;
                }
                Rectangle { height: 6px; }
                for g[i] in root.games: GameRow {
                    game: g;
                    selected: i == root.current && root.page == 0;
                    clicked => {
                        root.page = 0;
                        root.current = i;
                        root.select-game(i);
                    }
                }
                if root.games.length == 0: Text {
                    x: 10px;
                    text: "Nenhum jogo com loader de mods encontrado.";
                    color: Theme.faint;
                    wrap: word-wrap;
                }
                Rectangle { }
                SideLink {
                    text: "Adicionar jogo";
                    icon: @image-url("icons/plus.svg");
                    selected: root.page == 2;
                    clicked => {
                        root.page = 2;
                        root.show-add-game();
                    }
                }
                SideLink {
                    text: "Configurações";
                    icon: @image-url("icons/gear.svg");
                    selected: root.page == 1;
                    clicked => {
                        root.page = 1;
                        root.show-settings();
                    }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            SettingsPage {
                nexus-status: root.nexus-status;
                nexus-ok: root.nexus-ok;
                key-busy: root.key-busy;
                handler-ok: root.handler-ok;
                wallust-available: root.wallust-available;
                wallust-path: root.wallust-path;
                theme-mode <=> root.theme-mode;
                save-key(k) => { root.save-key(k); }
                clear-key => { root.clear-key(); }
                register-handler => { root.register-handler(); }
                open-key-page => { root.open-key-page(); }
                theme-changed(i) => { root.theme-changed(i); }
            }
            Rectangle { }
        }

        if root.page == 2: AddGamePage {
            games: root.unity-games;
            installing: root.installing;
            install(id, l) => { root.install-loader(id, l); }
        }

        if root.page == 0: VerticalLayout {
            // Cabeçalho no estilo da biblioteca do Steam: arte do jogo esmaecendo no fundo.
            Rectangle {
                height: 210px;
                clip: true;
                background: Theme.surface;
                Image {
                    source: root.hero;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: 0.7;
                }
                Rectangle {
                    background: @linear-gradient(180deg, Theme.bg.transparentize(0.85) 0%, Theme.bg.transparentize(0.35) 55%, Theme.bg 100%);
                }
                Rectangle {
                    background: @linear-gradient(90deg, Theme.bg.transparentize(0.25) 0%, Theme.bg.transparentize(1) 60%);
                }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-bottom: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.logo.width > 0: Image {
                            source: root.logo;
                            height: 84px;
                            image-fit: contain;
                            horizontal-alignment: left;
                        }
                        if root.logo.width == 0: Text {
                            text: root.game-name;
                            color: Theme.text;
                            font-size: 28px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.game-status;
                                color: root.game-warning ? Theme.warn : Theme.dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                                max-width: self.preferred-width;
                            }
                            if root.game-fix != "": LinkText {
                                text: "Copiar opção";
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                                clicked => { root.copy-fix(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.game-missing-loader != "": Button {
                                text: root.installing >= 0 ? "Instalando…" : "Instalar " + root.game-missing-loader;
                                enabled: root.installing < 0;
                                clicked => {
                                    root.install-loader(root.games[root.current].appid, root.game-missing-loader);
                                }
                            }
                            Button {
                                text: "Abrir pasta";
                                icon: @image-url("icons/folder.svg");
                                clicked => { root.open-folder(); }
                            }
                            Button {
                                text: root.busy ? "Instalando…" : "Adicionar mod";
                                icon: @image-url("icons/plus.svg");
                                enabled: !root.busy;
                                clicked => { root.add-mod(); }
                            }
                            Button {
                                text: "Jogar";
                                icon: @image-url("icons/play.svg");
                                primary: true;
                                clicked => { root.play(); }
                            }
                        }
                    }
                }
            }

            // Barra da lista: busca, filtro e contagem.
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 4px;
                padding-bottom: 12px;
                spacing: 12px;
                SearchBox {
                    width: 300px;
                    text <=> root.filter;
                    edited(t) => { root.filter-changed(t); }
                }
                Segmented {
                    options: ["Todos", "Ligados", "Desligados"];
                    current <=> root.filter-mode;
                    changed => { root.filter-changed(root.filter); }
                }
                Rectangle { }
                Text {
                    text: root.counts;
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Cabeçalho das colunas.
            HorizontalLayout {
                padding-left: 40px;
                padding-right: 40px;
                spacing: 16px;
                height: 24px;
                GroupLabel { text: "MOD"; vertical-alignment: center; }
                Rectangle { }
                if root.show-author: GroupLabel { width: Cols.author; text: "AUTOR"; vertical-alignment: center; }
                GroupLabel { width: Cols.version; text: "VERSÃO"; vertical-alignment: center; }
                Rectangle { width: Cols.remove; }
                GroupLabel { width: Cols.toggle; text: "ATIVO"; vertical-alignment: center; horizontal-alignment: right; }
            }
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
            }

            ScrollView {
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 4px;
                    padding-bottom: 16px;
                    for m in root.mods: ModRow {
                        item: m;
                        show-author: root.show-author;
                        toggled(v) => { root.toggle-mod(m.id, v); }
                        remove => { root.remove-mod(m.id); }
                        open-url(u) => { root.open-url(u); }
                    }
                    if root.mods.length == 0 && root.current >= 0: Text {
                        text: root.filter != "" ? "Nenhum mod com esse nome."
                            : root.filter-mode != 0 ? "Nada aqui."
                            : "Nenhum mod instalado. Use \"Adicionar mod\" ou o botão \"Mod Manager Download\" do Nexus.";
                        color: Theme.faint;
                        horizontal-alignment: center;
                        height: 100px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Arquivo sendo arrastado sobre a janela.
    if root.drop-hover: Rectangle {
        background: Theme.bg.transparentize(0.12);
        Rectangle {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: parent.height - 40px;
            border-radius: 14px;
            border-width: 2px;
            border-color: Theme.accent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.page == 0 && root.game-name != "" ? "Solte para instalar em " + root.game-name : "Abra um jogo para instalar";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Arquivos .zip, .7z ou .rar";
                    color: Theme.dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Avisos empilhados no canto superior direito. O Rust tira cada um depois de
    // 2,5 s; o andamento (progress) fica enquanto durar.
    VerticalLayout {
        x: parent.width - self.width - 20px;
        y: 20px;
        width: 380px;
        height: self.preferred-height;
        spacing: 8px;
        if root.progress != "": ToastCard {
            text: root.progress;
            closable: false;
        }
        for t in root.toasts: ToastCard {
            text: t.text;
            error: t.error;
            close => { root.dismiss-toast(t.id); }
        }
    }

    // Histórico de avisos (aberto pelo sino).
    if root.panel-open: TouchArea {
        clicked => { root.panel-open = false; }
    }
    if root.panel-open: Rectangle {
        x: 16px;
        y: 56px;
        width: 380px;
        height: root.notices.length == 0 ? 110px : min(460px, root.height - 80px, 64px + root.notices.length * 56px);
        border-radius: 10px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { }
        VerticalLayout {
            padding: 14px;
            padding-bottom: 8px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: "Notificações";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                if root.notices.length > 0: LinkText {
                    text: "Limpar";
                    vertical-alignment: center;
                    clicked => { root.clear-notices(); }
                }
            }
            if root.notices.length == 0: Text {
                text: "Nada por aqui.";
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                height: 48px;
            }
            if root.notices.length > 0: ScrollView {
                VerticalLayout {
                    spacing: 2px;
                    for n in root.notices: Rectangle {
                        border-radius: 6px;
                        background: ta.has-hover ? #ffffff06 : transparent;
                        ta := TouchArea { }
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                y: 6px;
                                border-radius: 3px;
                                background: n.error ? Theme.error : Theme.faint;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: n.text;
                                    color: n.error ? Theme.error : Theme.text;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: n.when;
                                    color: Theme.faint;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
